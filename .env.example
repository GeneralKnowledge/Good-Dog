# SQLite database file path
DATABASE_URL=./data/good-dog.db

# Secret used to sign session cookies (change in production)
AUTH_SECRET=dev-secret-change-me-to-a-long-random-string

# Default timezone for daily plans (UK)
DEFAULT_TIMEZONE=Europe/London

# Optional: OpenAI-compatible API for Ask screen enrichment.
# The core app works without this.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: Web Push training reminders (generate with: npx web-push generate-vapid-keys)
# VAPID_SUBJECT must be a mailto: or https: URL identifying the app contact.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=long-random-string-for-reminder-cron

